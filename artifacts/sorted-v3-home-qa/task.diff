+}
+@media (min-width: 1024px) and (max-width: 1200px) {
+  .mockupCta { font-size: 11px; padding-inline: 20px; }
+}
+
+/* ---------- Hero ---------- */
+.hero {
+  position: relative;
+  margin-top: -76px;
+  background: #070707;
+  color: #fff;
+  overflow: hidden;
+}
+.heroMedia {
+  position: absolute;
