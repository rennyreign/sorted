+    90deg,
+    #070707 0%,
+    rgba(7, 7, 7, 0.92) 30%,
+    rgba(7, 7, 7, 0.6) 52%,
+    rgba(7, 7, 7, 0.22) 72%,
+    rgba(7, 7, 7, 0.08) 100%
+  );
+}
+.heroInner {
