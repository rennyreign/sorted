# New Business Finder — Required Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to the repository.

# ---------------------------------------------------------------------------
# Companies House REST API
# Get your key at: https://developer.company-information.service.gov.uk/
# Use the key as the username and leave the password blank.
# ---------------------------------------------------------------------------
COMPANIES_HOUSE_API_KEY=your_api_key_here

# ---------------------------------------------------------------------------
# Supabase — Sorted project
# Project URL: https://qweevancxedkkfxysnzq.supabase.co
# Service role key (not the anon key): Settings > API > service_role
# ---------------------------------------------------------------------------
SUPABASE_URL=https://qweevancxedkkfxysnzq.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO   # DEBUG | INFO | WARNING | ERROR
