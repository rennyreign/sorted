{
  "name": "frontend-builder",
  "version": "0.1.0",
  "description": "Sorted frontend builder — generates a ready-to-deploy Next.js client site from a deconstruction JSON + asset manifest",
  "type": "module",
  "scripts": {
    "build-site": "tsc --noEmit && tsc && node dist/cli.js",
    "build": "tsc",
    "lint": "tsc --noEmit",
    "dev": "node --loader ts-node/esm src/cli.ts"
  },
  "bin": {
    "build-site": "./dist/cli.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.33.0",
    "dotenv": "^16.5.0",
    "zod": "^3.25.42"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
