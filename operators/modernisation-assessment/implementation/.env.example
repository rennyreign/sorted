# Modernisation Assessment Operator — environment variables
# This operator runs fully deterministically without any API keys.
# Optional keys add AI-generated narration and screenshot capture.

# Optional: OpenAI key for AI narration (executive summary, recommendations, mockup prompt)
OPENAI_API_KEY=

# Optional: Anthropic alternative for narration
ANTHROPIC_API_KEY=

# Optional: Supabase credentials to write results back to the prospects table
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional: ScreenshotOne API key for fast screenshot capture
# If unset and playwright is installed, Playwright headless Chromium is used.
SCREENSHOT_API_KEY=
