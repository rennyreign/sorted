# Prospect Finder — Required Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to the repository.

# ---------------------------------------------------------------------------
# Apify — Google Maps Scraper
# Get your token at: https://console.apify.com/account/integrations
# ---------------------------------------------------------------------------
APIFY_API_TOKEN=your_apify_api_token_here

# ---------------------------------------------------------------------------
# Supabase — Sorted project
# Project URL: https://qweevancxedkkfxysnzq.supabase.co
# Service role key (not the anon key): Settings > API > service_role
# ---------------------------------------------------------------------------
SUPABASE_URL=https://qweevancxedkkfxysnzq.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO   # DEBUG | INFO | WARNING | ERROR
