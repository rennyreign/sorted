# Environment: "local" | "production"
SORTED_UPDATES_ENV=local
SORTED_UPDATES_DEFAULT_CLIENT=gbhalesowen
SORTED_UPDATES_REPLY_STATE=.sorted-updates-state/replied_messages.json
SORTED_UPDATES_API_URL=http://127.0.0.1:8787
SORTED_UPDATES_MEMORY_ROOT=.sorted-updates-state/memory
SORTED_UPDATES_ESCALATION_STATE=.sorted-updates-state/escalations.json
WHATSAPP_PROVIDER=meta_cloud_api

# CORS — comma-separated list of allowed browser origins.
# Render sets this automatically via render.yaml.
# For local testing the default already includes http://localhost:3000.
SORTED_UPDATES_CORS_ORIGINS=https://graciebarrahalesowen.com,https://www.graciebarrahalesowen.com,http://localhost:3000

# Production (Render) — gunicorn is used; PORT is injected by the host.
# Start command: gunicorn --worker-class=gthread --threads=4 --bind=0.0.0.0:$PORT wsgi:application
# See render.yaml or Procfile for the canonical start command.

# Meta WhatsApp Cloud API
META_GRAPH_API_VERSION=v19.0
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_DISPLAY_NUMBER=

# GitHub preview branch / PR automation
GITHUB_INTEGRATION=pat
GITHUB_TOKEN=
GITHUB_REPOSITORY=rennyreign/gbhalesowen

# Netlify previews
NETLIFY_CONNECTED=true
NETLIFY_SITE_ID=

# Supabase portal auth / memory
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — GPT-4o mini classifier
OPENAI_API_KEY=

# Notifications
RESEND_API_KEY=
SORTED_MASTER_EMAIL=
