# Asset Generator — Environment Variables
# Copy this file to .env and fill in your keys.

# OpenAI — required for recreate mode (gpt-image-1 or dall-e-3)
# Also used by --ladder for the human branch and the similarity judge
OPENAI_API_KEY=sk-...

# Google Gemini — required for gemini-2.5-flash-image model and --ladder's Gemini rung
GEMINI_API_KEY=AIza...

# Black Forest Labs — required for recreate mode (flux-* models) and --ladder's flux rungs
FLUX_API_KEY=bfl_...
