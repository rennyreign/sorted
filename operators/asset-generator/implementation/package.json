{
  "name": "asset-generator",
  "version": "0.1.0",
  "description": "Sorted asset generator — produces production-ready image assets from a mockup + deconstruction JSON",
  "type": "module",
  "scripts": {
    "assets": "tsc --noEmit && tsc && node dist/cli.js",
    "build": "tsc",
    "lint": "tsc --noEmit",
    "dev": "node --loader ts-node/esm src/cli.ts"
  },
  "bin": {
    "assets": "./dist/cli.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.33.0",
    "dotenv": "^16.5.0",
    "openai": "^4.100.0",
    "sharp": "^0.33.5",
    "zod": "^3.25.42"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
