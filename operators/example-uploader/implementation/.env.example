# Example Uploader — Environment Variables
# Copy this file to .env and fill in your keys.

# Anthropic — required for AI-generated blurbs and case studies
ANTHROPIC_API_KEY=sk-ant-...

# Supabase — required for reading prospects and writing to the examples table
SUPABASE_URL=https://qweevancxedkkfxysnzq.supabase.co
SUPABASE_SERVICE_KEY=your-service-key-here

# Optional: override the path to the sorted repo root (defaults to ../../..)
SORTED_REPO_ROOT=../../..
