# Website Analyser — Required Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to the repository.

# ---------------------------------------------------------------------------
# Vision model — one of these is required
# Anthropic is the default (ANALYSER_MODEL=claude-haiku-4-5-20251001)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_key_here
# OPENAI_API_KEY=your_openai_key_here   # needed if ANALYSER_MODEL is a gpt model
# ANALYSER_MODEL=claude-haiku-4-5-20251001

# ---------------------------------------------------------------------------
# Supabase — Sorted project
# ---------------------------------------------------------------------------
SUPABASE_URL=https://qweevancxedkkfxysnzq.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ---------------------------------------------------------------------------
# ScreenshotOne — primary screenshot source (desktop + mobile captures)
# Without this, a local Playwright/Chromium fallback is used instead.
# ---------------------------------------------------------------------------
SCREENSHOT_API_KEY=your_screenshotone_key_here

# ---------------------------------------------------------------------------
# Companies House — viability check (free API key)
# Get one at: https://developer.company-information.service.gov.uk/
# Without this the CH step is skipped and Maps signals are used instead.
# ---------------------------------------------------------------------------
COMPANIES_HOUSE_API_KEY=your_companies_house_key_here

# ---------------------------------------------------------------------------
# Optional — qualification gate tuning
# ---------------------------------------------------------------------------
# QUALIFY_MIN_OPPORTUNITY=7      # minimum opportunity score to qualify
# QUALIFY_MAX_PAYBACK_JOBS=25    # max jobs-to-payback for £3,000 site
# QUALIFY_MAPS_MIN_RATING=4.0    # Maps fallback when no CH match
# QUALIFY_MAPS_MIN_REVIEWS=20
# LOG_LEVEL=INFO
