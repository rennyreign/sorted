# Mockup Deconstructor — Environment Variables
# Copy this file to .env and fill in the key for your chosen provider.

# OpenAI (default provider — gpt-4.1)
OPENAI_API_KEY=sk-...

# Anthropic Claude (optional — use with --provider anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini (optional — use with --provider gemini)
GEMINI_API_KEY=AIza...
