RewriteEngine On

# ── Sorted Sites lives at sites.sortmydigital.site ──────────────
# Subdomain root serves the sites homepage.
RewriteCond %{HTTP_HOST} ^sites\.sortmydigital\.site$ [NC]
RewriteRule ^$ /sites/ [L]

# Subdomain: collapse /sites/* URLs to clean paths.
RewriteCond %{HTTP_HOST} ^sites\.sortmydigital\.site$ [NC]
RewriteRule ^sites/?(.*)$ /$1 [R=301,L]

# Subdomain is Sorted Sites only — ops, campaigns and internal
# destinations return 404 here.
RewriteCond %{HTTP_HOST} ^sites\.sortmydigital\.site$ [NC]
RewriteRule ^(ops|agencies|v2|workspace|clients|proposals|brand-switchboard)(/|$) - [R=404,L]

# Main domain: /sites/* moves to the subdomain.
RewriteCond %{HTTP_HOST} !^sites\.sortmydigital\.site$ [NC]
RewriteRule ^sites/?(.*)$ https://sites.sortmydigital.site/$1 [R=301,L]

# Rewrite /review/[slug]/next to /review-next/index.html (next step SPA shell)
# Must come before the general review rewrite
RewriteRule ^review/([^/]+)/next/?$ /review-next/index.html [L,NC]

# Rewrite /review/* to /review/index.html (review page SPA shell)
# The client-side code reads the slug from window.location.pathname
RewriteRule ^review/(.+)/?$ /review/index.html [L,NC]

# Rewrite /workspace/:slug/* to /workspace/index.html (workspace SPA shell)
# The client-side code reads slug + route from window.location.pathname
# Existing files (e.g. /workspace/<client>/ad creatives) are served directly.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^workspace/(.+)/?$ /workspace/index.html [L,NC]
