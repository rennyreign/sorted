RewriteEngine On

# ── sites.sortmydigital.site is retired ─────────────────────────
# The Sorted homepage lives on the root domain again. Send any
# remaining subdomain traffic to sortmydigital.site.
RewriteCond %{HTTP_HOST} ^sites\.sortmydigital\.site$ [NC]
RewriteRule ^(.*)$ https://sortmydigital.site/$1 [R=301,L]

# AI assistants are now the flagship offer. The old /v4 and /automation
# page addresses redirect to the assistants equivalents.
# Match pages only: /v4/*.webp and /v4/logos/* remain static asset URLs.
RewriteRule ^v4/?$ /assistants/ [R=301,L]
RewriteRule ^automation/?$ /assistants/ [R=301,L]
RewriteRule ^v4/pricing/?$ /assistants/pricing/ [R=301,L]
RewriteRule ^automation/pricing/?$ /assistants/pricing/ [R=301,L]
RewriteRule ^v4/about/?$ /assistants/about/ [R=301,L]
RewriteRule ^automation/about/?$ /assistants/about/ [R=301,L]
RewriteRule ^v4/(how-it-works|demo)/?$ /assistants/ [R=301,L]
RewriteRule ^automation/(how-it-works|demo)/?$ /assistants/ [R=301,L]

# The operations offer is now served by AI assistants. Retired /ops
# and /v2 landing pages redirect to the assistants homepage.
RewriteRule ^ops/?$ /assistants/ [R=301,L]
RewriteRule ^v2/?$ /assistants/ [R=301,L]

# Rewrite /review/[slug]/next to /review-next/index.html (next step SPA shell)
# Must come before the general review rewrite
RewriteRule ^review/([^/]+)/next/?$ /review-next/index.html [L,NC]

# Rewrite /review/* to /review/index.html (review page SPA shell)
# The client-side code reads the slug from window.location.pathname
RewriteRule ^review/(.+)/?$ /review/index.html [L,NC]

# Rewrite /workspace/:slug/* to /workspace/index.html (workspace SPA shell)
# The client-side code reads slug + route from window.location.pathname
# Existing files (e.g. /workspace/<client>/ad creatives) are served directly.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^workspace/(.+)/?$ /workspace/index.html [L,NC]
