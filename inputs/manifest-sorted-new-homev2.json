        {
          "label": "Our work",
          "href": "/work"
        },
        {
          "label": "Contact",
          "href": "/contact"
        }
      ]
    },
    "contact_column": {
      "heading": "Let’s talk",
      "primary_cta": "Book a call",
      "social_icons": [
        "LinkedIn",
        "Instagram"
      ]
    },
    "handwritten_annotation": "LOCAL BUSINESSES. BRIGHTER FUTURES.",
    "legal_links": [
      "Privacy",
      "Terms",
      "Cookies"
    ],
    "copyright": "© 2026 Sorted. All rights reserved."
  },

  "components": {
    "button_primary_dark": {
      "height": "52px",
      "padding_horizontal": "24px",
      "background": "#08251F",
      "text": "#FFFFFF",
      "border_radius": "999px",
      "icon": "arrow-right"
    },
    "button_primary_lime": {
      "height": "52px",
      "padding_horizontal": "28px",
      "background": "#D8FF18",
      "text": "#081614",
      "border_radius": "999px",
      "icon": "arrow-right"
    },
    "button_outline": {
      "height": "52px",
      "padding_horizontal": "24px",
      "background": "transparent",
      "border": "1px solid #A9B0AD",
      "text": "#081614",
      "border_radius": "999px"
    },
    "check_item": {
      "icon": "small lime circle with dark checkmark",
      "gap": "10px"
    },
    "metric_card": {
      "background": "#FFFFFF",
      "border_radius": "16px",
      "overflow": "hidden",
      "image_ratio": "4:3",
      "metric_weight": 800,
      "metric_size": "32px"
    }
  },

  "interaction": {
    "buttons": {
      "hover": "slight upward movement, subtle shadow increase, arrow shifts 3-4px right",
      "duration": "180ms"
    },
    "product_cards": {
      "hover": "very subtle lift and shadow; no dramatic animation"
    },
    "navigation": {
      "sticky": false
    },
    "motion_rule": "Motion should support clarity and polish. Avoid large animated sequences."
  },

  "responsive_rules": {
    "desktop": {
      "breakpoint": ">= 1100px",
      "hero_layout": "split",
      "offer_cards": "two columns",
      "results": "intro plus three cards",
      "process": "four horizontal steps"
    },
    "tablet": {
      "breakpoint": "768px-1099px",
      "hero_layout": "split with reduced typography",
      "offer_cards": "two columns where possible",
      "results": "two-column wrap",
      "process": "two-by-two grid"
    },
    "mobile": {
      "breakpoint": "< 768px",
      "hero_layout": "single column",
      "hero_image_position": "below CTA buttons",
      "headline_size": "42px",
      "offer_cards": "single column",
      "results": "stack",
      "process": "vertical",
      "final_cta": "stack content",
      "footer": "stack columns",
      "buttons": "full-width where appropriate"
    }
  },

  "content_rules": {
    "language": [
      "plain English",
      "local business language",
      "commercially useful",
      "short sentences",
      "minimal jargon",
      "specific outcomes"
    ],
    "preferred_terms": [
      "customers",
      "enquiries",
      "bookings",
      "website",
      "advertising",
      "local business",
      "get found",
      "look better",
      "more customers",
      "get sorted"
    ],
    "avoid_terms": [
      "digital transformation",
      "end-to-end",
      "ecosystem",
      "omnichannel",
      "growth stack",
      "MarTech",
      "workflow orchestration",
      "AI-powered solutions",
      "holistic strategy"
    ]
  },

  "strategic_rules": {
    "primary_rule": "The page must remain simple enough that a local business owner understands the proposition in under 10 seconds.",
    "public_products_only": [
      "Sorted Sites",
      "Sorted Ads"
    ],
    "do_not_create_top_level_cards_for": [
      "automation",
      "analytics",
      "CRM",
      "reporting",
      "booking systems",
      "payments",
      "reviews",
      "tracking"
    ],
    "supporting_capabilities_rule": "Supporting systems may be mentioned inside Sites or Ads, but never positioned as equal public product categories on this page.",
    "navigation_rule": "Do not add a Services dropdown or additional top-level service taxonomy.",
    "homepage_role": "The homepage is both the Sorted brand statement and the route-selection page. Do not create an additional selector page."
  },

  "implementation_notes_for_non_vision_model": {
    "priority_order": [
      "Preserve the hierarchy: Sorted parent brand > Sites and Ads",
      "Keep hero extremely simple",
      "Make Sites and Ads cards visually dominant immediately after hero",
      "Use large typography and generous whitespace",
      "Keep local-business photography human and credible",
      "Use lime only as a high-attention accent",
      "Use dark green for strong CTA/footer surfaces",
      "Use handwritten annotations sparingly",
      "Do not add extra services to the primary product grid"
    ],
    "critical_visual_identity": [
      "off-white canvas",
      "dark green",
      "lime accents",
      "oversized black typography",
      "rounded panels",
      "real local-business photography",
      "handwritten annotations",
      "simple arrows",
      "clean commercial cards"
    ]
  }
}