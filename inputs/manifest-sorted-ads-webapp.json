      },
      "schedule": {
        "fields": [
          "start date",
          "end date",
          "run time",
          "budget",
          "optimisation"
        ],
        "edit_mode": "inline or modal"
      },
      "final_confirmation": {
        "display": "compact review state on same page",
        "requires": [
          "selected ads",
          "dates",
          "budget or inherited budget",
          "connected ad account"
        ],
        "primary_action": "Publish ads"
      }
    },
    "06-results": {
      "manifest_type": "screen_design_ir",
      "screen_id": "results",
      "route_pattern": "/campaigns/:campaignId/results",
      "purpose": "Show measurable campaign performance and allow quick comparison by angle and copy length.",
      "header": {
        "title": "Results",
        "subtitle": "Real performance. Clear decisions.",
        "date_picker": "upper-right"
      },
      "top_metrics": [
        {
          "name": "Impressions",
          "format": "integer",
          "delta": true
        },
        {
          "name": "Link clicks",
          "format": "integer",
          "delta": true
        },
        {
          "name": "Registrations",
          "format": "integer",
          "delta": true
        },
        {
          "name": "Cost per result",
          "format": "currency",
          "delta": true
        }
      ],
      "chart": {
        "title": "Registrations over time",
        "type": "single-series line chart with subtle area fill",
        "metric_selector": true,
        "style": "thin dark-green line, light grid, no visual noise"
      },
      "right_metrics": {
        "title": "Performance metrics",
        "items": [
          "Click through rate (CTR)",
          "Conversion rate (click → registration)",
          "Cost per click (CPC)",
          "Cost per registration",
          "Impression to registration rate",
          "Total spend"
        ],
        "each_item": [
          "current value",
          "percentage change"
        ],
        "color_rule": "Green for favourable movement, red for unfavourable movement; cost decreases are favourable."
      },
      "channel_breakdown": {
        "title": "Performance by channel",
        "items": [
          "Facebook",
          "Instagram"
        ],
        "show": [
          "share of registrations",
          "rate",
          "percentage change"
        ]
      },
      "performance_table": {
        "filters": [
          "All angles",
          "All copy lengths"
        ],
        "export": true,
        "columns": [
          "Ad",
          "Angle",
          "Copy",
          "Impressions",
          "Link clicks",
          "Registrations",
          "Cost per result",
          "CTR",
          "Conversion rate",
          "Status"
        ],
        "row_thumbnail": true
      },
      "explicitly_exclude": [
        "AI key insights panel",
        "Narrative recommendations panel"
      ]
    },
    "07-client-review": {
      "manifest_type": "screen_design_ir",
      "screen_id": "client_review",
      "route_pattern": "/review/:shareToken",
      "purpose": "Give clients a simple way to approve, request changes and comment.",
      "audience": "external client",
      "shell": {
        "sidebar": false,
        "internal_navigation": false,
        "header": [
          "Sorted.",
          "campaign name",
          "key date"
        ],
        "visual_density": "lower than internal app"
      },
      "layout": {
        "type": "responsive review grid",
        "desktop_columns": 3,
        "mobile": "one card at a time"
      },
      "review_card": {
        "content_order": [
          "angle / variant label",
          "primary copy",
          "shared creative",
          "headline",
          "description",
          "CTA",
          "approve",
          "request changes",
          "comment"
        ],
        "actions": [
          "Approve",
          "Request changes",
          "Add comment"
        ],
        "status_feedback": "Immediate visible state change after action."
      },
      "global_actions": {
        "approve_all": true,
        "comment_mode": "optional campaign-level comment"
      },
      "navigation": {
        "desktop": "grid scroll",
        "mobile": "previous / next",
        "progress": "e.g. 3 of 12"
      },
      "rules": [
        "Do not expose internal campaign settings.",
        "Do not expose publishing controls.",
        "Do not expose results unless intentionally shared later.",
        "Keep copy and creative visually close so the client judges the ad as one object.",
        "Feedback must flow back to the internal campaign-detail page."
      ]
    }
  }
}