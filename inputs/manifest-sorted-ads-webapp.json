      },
      "filters": {
        "tabs": [
          "All assets",
          "Images",
          "Videos",
          "Deleted"
        ],
        "search": true,
        "filter_button": true
      },
      "layout": {
        "content": "asset grid",
        "desktop_grid_columns": 4,
        "right_inspector": "opens only when an asset is selected"
      },
      "asset_card": {
        "media": "square-ish or portrait thumbnail depending on source",
        "overlay_controls": [
          "select checkbox",
          "overflow"
        ],
        "metadata": [
          "filename",
          "media type",
          "aspect ratio",
          "file size"
        ],
        "video": "show play icon and duration"
      },
      "inspector": {
        "width": 320,
        "content": [
          "large preview",
          "file details",
          "usage references",
          "replace",
          "download",
          "duplicate",
          "delete"
        ],
        "usage_reference": "Show campaign angle(s) using the asset."
      },
      "interaction": {
        "multi_select": "supported",
        "replace_asset": "may preserve current angle assignment",
        "delete": "destructive confirmation required",
        "close_inspector": "X in upper-right"
      }
    },
    "05-publishing": {
      "manifest_type": "screen_design_ir",
      "screen_id": "publishing",
      "route_pattern": "/campaigns/:campaignId/publishing",
      "purpose": "Select approved variants, configure schedule and publish with minimal friction.",
      "header": {
        "title": "Publishing",
        "subtitle": "Get your approved ads live.",
        "secondary_action": "Preview plan",
        "primary_action": "Publish ads"
